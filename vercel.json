{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.main:app",
      "installCommand": "pip install -r backend/requirements.txt",
      "functions": {
        "backend/main.py": {
          "includeFiles": "models/**"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "VITE_API_BASE=\"\" npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
